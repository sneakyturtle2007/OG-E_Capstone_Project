@rendermode InteractiveServer
@implements IAsyncDisposable

@using TheAndersonProject.Services
@using TheAndersonProject.Components

@inject IJSRuntime JSRuntime
@inject MapData MapData


<div id="map"></div> 

@code{
    public static Dictionary<string, List<ReaderEvent>> eventsByLocation { get; set; } = new Dictionary<string, List<ReaderEvent>>();
    private static IJSObjectReference? module;
    private static List<double[]> siteCoordinates = new List<double[]>();
    protected override void OnInitialized(){
        if(MapData.EventsByLocation.Count != 0){
            RestoreMapInfo();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender){
        if (firstRender){
            module = await JSRuntime.InvokeAsync<IJSObjectReference>("import",
                "./Components/Pages/Map.razor.js");
            
            siteCoordinates = await module.InvokeAsync<List<double[]>>("MapInit", "Site", eventsByLocation.Keys, siteCoordinates);
            SaveMapInfo();
        }
        
    }
    void SaveMapInfo(){
        MapData.EventsByLocation = eventsByLocation;
        MapData.SiteLocations = siteCoordinates; 
    }
    void RestoreMapInfo(){
        eventsByLocation = MapData.EventsByLocation;
        siteCoordinates = MapData.SiteLocations;
    }
    [JSInvokable]
    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                
            }
        }
    }
}

