@rendermode InteractiveServer
@implements IAsyncDisposable

@using TheAndersonProject.Services
@using TheAndersonProject.Components

@inject IJSRuntime JSRuntime
@inject MapData MapData
@inject SiteData SiteData
@inject AdditionalInfo AdditionalInfo
@inject NavigationManager navigationManager

@if(SiteData.DisplaySiteInfo){
    
    <div id="map">
        @if(SiteData.DisplaySiteInfo){
            <div class="backButton" style="align-self: start;" @onclick="@back"><p>Back</p></div>
        }
    </div>
}else{
    <div id="map" style="background-image:url('img/map.png');"></div>
}
 

@code{
    public static List<Site> sites { get; set; } = new List<Site>();
    private static IJSObjectReference? module;
    private static List<double[]> elementCoordinates = new List<double[]>();

    protected override async Task OnAfterRenderAsync(bool firstRender){
        RestoreMapInfo("sites");
        if (firstRender && sites.Count > 0 ){
            module = await JSRuntime.InvokeAsync<IJSObjectReference>("import",
                "./Components/Pages/Map.razor.js");
            if(SiteData.DisplaySiteInfo){
                RestoreMapInfo("readers&panels");
                List<ReaderEvent> readerEvents = SiteData.ReaderEvents;
                Dictionary<string, List<ReaderEvent>> eventsByReader = SiteData.OrganizeEvents_StringKey(readerEvents, "reader");
                
                Dictionary<int, List<ReaderEvent>> eventsByPanel = SiteData.OrganizeEvents_IntKey(readerEvents);
                string[] readerNames = new string[eventsByReader.Count];
                int[] panelNames = new int[eventsByPanel.Count];
                int tempIndex = 0;
                foreach(KeyValuePair<string, List<ReaderEvent>> kvp in eventsByReader){
                    readerNames[tempIndex] = kvp.Key;
                    tempIndex++;
                }
                tempIndex = 0;
                foreach(KeyValuePair<int, List<ReaderEvent>> kvp in eventsByPanel){
                    panelNames[tempIndex] = kvp.Key;
                    tempIndex++;
                }
                elementCoordinates = await module.InvokeAsync<List<double[]>>("SiteInit", readerNames, panelNames, elementCoordinates);
                SaveMapInfo("readers&panels");
            }else{
                
                string[] siteNames = new string[sites.Count];
                for(int i = 0; i < sites.Count; i++){
                    siteNames[i] = sites[i].SiteName;
                }
                elementCoordinates = await module.InvokeAsync<List<double[]>>("MapInit", siteNames, elementCoordinates);
                SaveMapInfo("sites");
            }
        }
    }
    void back(){
        SiteData.DisplaySiteInfo = false;
        AdditionalInfo.content.Clear();
        AdditionalInfo.content.Add("Additional information will be displayed here.");
        navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
    }
    void SaveMapInfo(string category){
        switch(category){
            case "sites":
                MapData.SiteCoordinates = elementCoordinates;
                break;
            case "readers&panels":
                MapData.Reader_PanelCoordinates = elementCoordinates;
                break;
            default:
                break;
        }
        
    }
    void RestoreMapInfo(string category){
        if(category == "sites"){
            sites = MapData.Sites;
            elementCoordinates = MapData.SiteCoordinates;
        }else{
            elementCoordinates = MapData.Reader_PanelCoordinates;
        }
        
    }

    [JSInvokable]
    public static void SelectElement(string elementName, string category){
        switch(category){
            case "sites":
                foreach(Site site in sites){
                    if(site.SiteName == elementName){
                        SiteData.SiteName = site.SiteName;  
                        SiteData.ReaderEvents = site.ReaderEvents;
                        SiteData.ReaderEventsCount = site.ReaderEvents.Count;
                        SiteData.DisplaySiteInfo = true;
                        AdditionalInfo.content.Clear();
                        AdditionalInfo.content.Add("Site: " + elementName);
                        AdditionalInfo.content.Add("Number of readers: " + SiteData.OrganizeEvents_StringKey(site.ReaderEvents, "reader").Count);
                        AdditionalInfo.content.Add("Number of panels: " + SiteData.OrganizeEvents_IntKey(site.ReaderEvents).Count);
                        AdditionalInfo.content.Add("Number of users: " + SiteData.OrganizeEvents_StringKey(site.ReaderEvents, "user").Count);
                        FileData.LoadInfo(site.SiteName);
                    }
                }
                
                break;
            case "readers":
                AdditionalInfo.content.Clear();
                AdditionalInfo.content.Add("Reader: " + elementName);
                
                foreach(ReaderEvent readerEvent in SiteData.ReaderEvents){
                    if(readerEvent.ReaderDesc == elementName){
                        AdditionalInfo.content.Add("Parent Panel: " + readerEvent.Machine);
                        break;
                    }
                }
                string mostInteractiveUser = "";
                Dictionary<string, List<ReaderEvent>> eventsByReader = SiteData.OrganizeEvents_StringKey(SiteData.ReaderEvents, "reader");
                foreach(KeyValuePair<string, List<ReaderEvent>> kvp in eventsByReader){
                    if(kvp.Key == elementName){
                        Dictionary<string, List<ReaderEvent>> temp = SiteData.OrganizeEvents_StringKey(kvp.Value, "user");
                        List<string> mostActiveUsers = SiteData.OrganizeCount_String(temp);
                        mostInteractiveUser = mostActiveUsers[0];
                        break;
                    }
                }
                AdditionalInfo.content.Add("Most active user: " + mostInteractiveUser);
                break;
            case "panels":
                AdditionalInfo.content.Clear();
                AdditionalInfo.content.Add("Panel: " + elementName);
                List<string> temp2 = new List<string>();
                int index = 0;
                foreach(ReaderEvent readerEvent in SiteData.ReaderEvents){
                    if(readerEvent.Machine.ToString() == elementName){
                        if(index == SiteData.ReaderEvents.Count -1 && !temp2.Contains(readerEvent.ReaderDesc)){
                            temp2.Add(readerEvent.ReaderDesc);
                        }else if(!temp2.Contains(readerEvent.ReaderDesc)){
                            temp2.Add(readerEvent.ReaderDesc);
                        }
                    }
                }
                string temp3 = "";
                for(int i = 0; i < temp2.Count; i++){
                    if(i == temp2.Count - 1){
                        temp3 += temp2[i];
                    }else{
                        temp3 += temp2[i] + ", ";
                    }
                }
                AdditionalInfo.content.Add("Connected Readers: " + temp3);
                break;
            default:
                break;
        }
    }
    [JSInvokable]
    public static void UpdateElementLocation(double[] coordinates, int index, string category){
        
        if(category == "sites"){
            MapData.SiteCoordinates[index] = coordinates;
        }else{
            MapData.Reader_PanelCoordinates[index] = coordinates;
        }
    }   
    async ValueTask IAsyncDisposable.DisposeAsync(){
        if (module is not null){
            try{
                await module.DisposeAsync();
            }catch (JSDisconnectedException){
                
            }catch(TaskCanceledException ){
                
            }
        }
    }
    
}

