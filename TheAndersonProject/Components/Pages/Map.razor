@rendermode InteractiveServer
@implements IAsyncDisposable

@using TheAndersonProject.Services
@using TheAndersonProject.Components

@inject IJSRuntime JSRuntime
@inject MapData MapData


<div id="map"></div> 

@code{
    public Dictionary<string, List<ReaderEvent>> eventsByLocation { get; set; } = new Dictionary<string, List<ReaderEvent>>();
    private IJSObjectReference? module;
    private List<double[]> elementLocations = new List<double[]>();
    protected override void OnInitialized(){
        if(MapData.EventsByLocation.Count != 0){
            RestoreMapInfo();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender){
        if (firstRender){
            module = await JSRuntime.InvokeAsync<IJSObjectReference>("import",
                "./Components/Pages/Map.razor.js");
            
            elementLocations = await module.InvokeAsync<List<double[]>>("MapInit", "Site", eventsByLocation.Keys);// eventsByLocation.Keys.ToArray(), "Site"
            Console.WriteLine("" + elementLocations.Count);
        }
        
    }
    void SaveMapInfo(){
        MapData.EventsByLocation = eventsByLocation;
    }
    void RestoreMapInfo(){
        eventsByLocation = MapData.EventsByLocation;
    }
    [JSInvokable]
    /*public static async Task UpdateMap(string[] locations, string siteName){
        if (locations.Length > 0){
            await module.InvokeVoidAsync("RefreshMap", locations, siteName);
        }
    }*/
    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                
            }
        }
    }
}

