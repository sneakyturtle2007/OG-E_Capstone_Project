@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using TheAndersonProject.Services 
@using TheAndersonProject.Components

@inject FileData FileData
@inject MapData MapData
@inject NavigationManager navigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Home</PageTitle>
<div id="main">
  <Map/>
  <FileUpload/>
</div>
<div class="newFile" @onclick="@reset"><p>Reset</p></div>


@code{
  private static IJSObjectReference? module;
	protected override async Task OnAfterRenderAsync(bool firstRender){

    if(firstRender){
      module = await JSRuntime.InvokeAsync<IJSObjectReference>("import",
        "./Components/Pages/Map.razor.js");
    }
  }
  
  void reset(){
    FileData.FileName = "";
    FileData.ReaderEventsCount = 0;
    FileData.ReaderEvents = new List<ReaderEvent>();
    MapData.Sites = new List<Site>();
    MapData.SiteCoordinates = new List<double[]>();
    SiteData.DisplaySiteInfo = false;
    SiteData.SiteName = "";
    SiteData.ReaderEvents = new List<ReaderEvent>();
    SiteData.ReaderEventsCount = 0;
    SiteData.YearMonth = new int[2]{0,0};
    AdditionalInfo.content = new List<string>();
    AdditionalInfo.content.Add("No file uploaded.");
    StateHasChanged();
    navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true); 
  }
  
  [JSInvokable]
  async ValueTask IAsyncDisposable.DisposeAsync(){
    if (module is not null){
      try{
        await module.DisposeAsync();
      }catch (JSDisconnectedException){

      }catch(TaskCanceledException ){
                
      }
    }
  }
}
