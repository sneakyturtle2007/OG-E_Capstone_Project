@rendermode InteractiveServer
@using TheAndersonProject.Services
@using TheAndersonProject.Components

@inject FileData FileData
@inject AdditionalInfo AdditionalInfo
@inject NavigationManager navigationManager
<div class="main">
  <div class="monthManagement">
      <h5>Most Active Days:</h5>
      <h5>@currDay.ToString("yyyy")</h5>
      <div>
        <div class="navButtons" @onclick="PreviousMonth">&#8678;</div>
        @{
          <h5 class="monthDay">@currDay.ToString("MMMM")</h5>
        }
        <div class="navButtons" @onclick="NextMonth">&#8680;</div>
      </div> 
  </div>
  <table>
    <tr>
      <th>Sunday</th>
      <th>Monday</th>
      <th>Tuesday</th>
      <th>Wednesday</th>
      <th>Thursday</th>
      <th>Friday</th>
      <th>Saturday</th>
    </tr>
    
    @for(int week = 0; week < 6; week++){
      <tr>
        @for(int day = 0; day < 7; day++){
          
          @if(numOfDay == 1 && currDay.ToString("dddd") != daysOfWeek[day]){
            
            month -= 1;
            if(month <= 0){
              month = 12;
              year--;
            }
            daysInMonth = DateTime.DaysInMonth(year, month);
            numOfDay = daysInMonth - (Array.FindIndex(daysOfWeek,day => day == currDay.ToString("dddd")) - 1);
            string intensity = GetIntensity(numOfDay, day);
            <td style="background-color: rgb(@intensity, @intensity, 255, 1);">@numOfDay</td>
            numOfDay++; 
          }else{
            string intensity = GetIntensity(numOfDay, day);
            <td style="background-color: rgb(@intensity, @intensity, 255, 1);">@numOfDay</td>
            numOfDay++;
          }
          @if(numOfDay > daysInMonth){
            numOfDay = 1;
                  
            @if(month == 12){
              month = 1;
              year++; 
            }else{
              month++;
            }
            daysInMonth = DateTime.DaysInMonth(year, month);

            currDay = new DateTime(year, month, numOfDay);
          }   
        }
      </tr>
      @if(week == 5){
        month--;
        if(month == 0){
          year --;
          month = 12;
        }
      }
    }
  </table>
  
  <table title="Avg. Number of Users Per Day">
    <tr><th colspan="7">Avg. Number of Users Per Day</th></tr>
    <tr>
      <th>Sunday</th>
      <th>Monday</th>
      <th>Tuesday</th>
      <th>Wednesday</th>
      <th>Thursday</th>
      <th>Friday</th>
      <th>Saturday</th>
    </tr>
    <tr>
      @{
        float numOfUsers = 0;
      }
      @for(int i = 0; i < 7; i++){
        numOfUsers = (avgNumOfUsersPerDay[i] / maxNumOfUniqueIDsPerDay) * 125 * 1.4f;
        if(numOfUsers > 165){
          numOfUsers = 165;
        }
        
        string resultIntensity = ( 255 - numOfUsers).ToString();
        <td style="background-color: rgb(@resultIntensity, @resultIntensity, 255, 1);">@avgNumOfUsersPerDay[i]</td>
      }
    </tr>
  </table>
  <div class="heatKey" > </div>
  <div class="heatKeyValues">
    <p>0</p>
    <p>Number of Users</p>
    <p>@maxNumOfUniqueIDsPerDay</p>
  </div>
  <Info/>
</div>


@code{
  string[] dateYM;
  int year;
  int month;
  int daysInMonth;
  DateTime currDay;
  int numOfDay = 1;
  string[] daysOfWeek = new string[7]{"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
  
  float maxNumOfUniqueIDsPerDay = 0;
  int maxNumofUsersPerDay_InWeek = 0;
  int[] avgNumOfUsersPerDay = new int[7]{0,0,0,0,0,0,0};
  bool tableRendered = false;

  [Parameter]
  public Dictionary<string, List<string>> userIDByDate {get; set;} = new Dictionary<string, List<string>>();
  

  protected override void OnInitialized(){
    Refresh();
  }
  public void Refresh(){
    dateYM = DateTime.Now.ToString("yyyy/MM").Split('/');
    if(SiteData.YearMonth[0] == 0){
      SiteData.YearMonth[0] = Int32.Parse(dateYM[0]);
      SiteData.YearMonth[1] = Int32.Parse(dateYM[1]);
    }
    year = SiteData.YearMonth[0];
    month = SiteData.YearMonth[1];
    daysInMonth = DateTime.DaysInMonth(year, month);
    currDay = new DateTime(year, month, 1);
    int tempNumOfUniqueIDs = 0;
    foreach(KeyValuePair<string, List<string>> kvp in userIDByDate){
      tempNumOfUniqueIDs = kvp.Value.Count;
      if(tempNumOfUniqueIDs > maxNumOfUniqueIDsPerDay){
        maxNumOfUniqueIDsPerDay = tempNumOfUniqueIDs;
      }
    }
    NextMonth();
    PreviousMonth();
  }
  string GetIntensity(int day, int weekDay){
    
    string tempMonth = month.ToString().PadLeft(2,'0');
    string tempDay = day.ToString().PadLeft(2,'0');
    string date = $"{year}-{tempMonth}-{tempDay}";
    string resultIntensity = "";
    float colorIntensity;
    ;
    if(userIDByDate.ContainsKey(date)){
      avgNumOfUsersPerDay[weekDay] += userIDByDate[date].Count;
      avgNumOfUsersPerDay[weekDay] = (int) (avgNumOfUsersPerDay[weekDay] / 2);
      colorIntensity = (userIDByDate[date].Count / maxNumOfUniqueIDsPerDay) * 125 * 1.4f;
      if(colorIntensity > 165){
        colorIntensity = 165;
      }
      
      resultIntensity = ( 255 - (int) colorIntensity).ToString();
    }else{
      resultIntensity = "255";
    }
    return resultIntensity; 
  }
  void PreviousMonth(){
    month--;
    if(month <= 0){
      month = 12;
      year --;
    }
    InitializeNewCalendarData();
    StateHasChanged();
  }
  void NextMonth(){
    month++;
    if(month > 12){
      month = 1;
      year ++;
    }
    InitializeNewCalendarData();
    StateHasChanged();
  }
  void InitializeNewCalendarData(){
    SiteData.YearMonth[0] = year;
    SiteData.YearMonth[1] = month;
    dateYM = new DateTime(year, month, 1).ToString("yyyy/MM").Split("/");
    daysInMonth = DateTime.DaysInMonth(year, month);
    numOfDay = 1;
    currDay = new DateTime(year, month, 1);
  }

}

