@rendermode InteractiveServer
@using TheAndersonProject.Services
@using TheAndersonProject.Components

@inject FileData FileData

<div class="main">
  <div class="monthManagement">
      <h5>Most Active Days:</h5>
      <h5>@currDay.ToString("yyyy")</h5>
      <div>
        <div class="navButtons" @onclick="PreviousMonth">&#8678;</div>
        @{
          <h5 class="monthDay">@currDay.ToString("MMMM")</h5>
        }
        <div class="navButtons" @onclick="NextMonth">&#8680;</div>
      </div>  
  </div>
  <table>
    <tr>
      <th>Sunday</th>
      <th>Monday</th>
      <th>Tuesday</th>
      <th>Wednesday</th>
      <th>Thursday</th>
      <th>Friday</th>
      <th>Saturday</th>
  </tr>
    @{
      string tempMonth = "";
      string tempDay = "";
    }
    @for(int week = 0; week < 6; week++){
      <tr>
        @for(int day = 0; day < 7; day++){
          tempMonth = month.ToString().PadLeft(2,'0');
          tempDay = day.ToString().PadLeft(2,'0');
          if(userIDByDate.ContainsKey($"{year}-{tempMonth}-{tempDay}")){
            gradientRadius = (userIDByDate[$"{year}-{tempMonth}-{tempDay}"].Count /2).ToString() + "px";
          }else{
            gradientRadius = "0px";
          }
          
          @if(numOfDay == 1 && currDay.ToString("dddd") != daysOfWeek[day]){
            
            month -= 1;
            if(month <= 0){
              month = 12;
              year--;
            }
            daysInMonth = DateTime.DaysInMonth(year, month);
            numOfDay = daysInMonth - (Array.FindIndex(daysOfWeek,day => day == currDay.ToString("dddd")) - 1);
            
            <td style="background-image: radial-gradient(circle @gradientRadius at center, rgb(173, 216, 230, 1), white);">@numOfDay</td>
            numOfDay++; 
          }else{
            <td style="background-image: radial-gradient(circle @gradientRadius at center, rgb(173, 216, 230, 1 ), white);">@numOfDay</td>
            numOfDay++;
          }
          @if(numOfDay  > daysInMonth){
            numOfDay = 1;
                  
            @if(month == 12){
              month = 1;
              year++; 
            }else{
              month++;
            }
            daysInMonth = DateTime.DaysInMonth(year, month);

            currDay = new DateTime(year, month, numOfDay);
          }   
        }
      </tr>
      @if(week == 5){
        month--;
        if(month == 0){
          year --;
          month = 12;
        }
      }
    }
  </table>
</div>


@code{
  string[] dateYM;
  int year;
  int month;
  int daysInMonth;
  DateTime currDay;
  int numOfDay = 1;
  string[] daysOfWeek = new string[7]{"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
  
  string gradientRadius = "";
  [Parameter]
  public Dictionary<string, List<string>> userIDByDate {get; set;} = new Dictionary<string, List<string>>();
  

  protected override void OnInitialized(){
    dateYM = DateTime.Now.ToString("yyyy/MM").Split('/');
    year = Int32.Parse(dateYM[0]);
    month = Int32.Parse(dateYM[1]);
    daysInMonth = DateTime.DaysInMonth(year, month);
    currDay = new DateTime(year, month, 1);
    gradientRadius = "100px";
  }

  string GetGradientRadius(int year, int month, int day){
    string date = $"{year}/{month}/{day}";
    return "placeholder"; 
  }
  void PreviousMonth(){
    Console.WriteLine("Prev: " + month);
    month--;
    if(month <= 0){
      month = 12;
      year --;
    }
    InitializeNewCalendarData();
    Console.WriteLine("After: " + month);
    StateHasChanged();
  }
  void NextMonth(){
    Console.WriteLine(month);
    month++;
    if(month > 12){
      month = 1;
      year ++;
    }
    InitializeNewCalendarData();
    Console.WriteLine(month);
    StateHasChanged();
  }
  void InitializeNewCalendarData(){
    dateYM = new DateTime(year, month, 1).ToString("yyyy/MM").Split("/");
    daysInMonth = DateTime.DaysInMonth(year, month);
    numOfDay = 1;
    currDay = new DateTime(year, month, 1);
  }
}