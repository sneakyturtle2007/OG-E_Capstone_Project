@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using TheAndersonProject.Services
@using TheAndersonProject.Components

@inject FileData FileData
@inject MapData MapData
@inject SiteData SiteData
@inject UserSettings UserSettings
@inject NavigationManager navigationManager


@if (!string.IsNullOrEmpty(ErrorMessage)){
    <div>Error: @ErrorMessage</div>
}   

<div class="main">
    @if(FileData.FileName == ""){
        <InputFile OnChange="@FileUploaded"/>
    }else{
        if(@SiteData.DisplaySiteInfo){
            <div class="listContainer">
                <h4>@SiteData.SiteName</h4>
                <h6 class="listTitle">Most Visited Readers:</h6>
                <div class="list">
                    <div class="columnNames"><div class="title">Reader Name</div> <p>|</p> <span class="interactions">Scans</span></div>
                    @{
                        int maintenanceIndex = 0;
                    }
                    @for(int i = 0; i < readerIDByEventCount.Count; i++){
                        string readerID = readerIDByEventCount[i];
                        int temp = i;
                        <div class="listElement">
                            <div class="title">@readerID</div>
                            @if(i < SiteData.ReaderMaintenance.Count){
                                maintenanceIndex = SiteData.ReaderMaintenance[readerID];
                                @if( @eventsByReader[readerID].Count/maintenanceIndex > UserSettings.ReaderMaintenanceTheshold){
                                    <span class="Alert" @onclick="() => {HandleAlert('m', true, temp, readerID);}">Maintenance!</span>
                                }
                            }
                            <span class="interactions">@eventsByReader[readerID].Count</span>
                        </div>
                    }
                </div>
                <h6 class="listTitle">Most Active Panels:</h6>
                <div class="list">
                    <div class="columnNames"><div class="title">Panel Name</div> <p>|</p><span class="interactions">Pings</span></div>
                    @foreach(int panelID in panelIDByEventCount){
                        <div class="listElement">
                            <div class="title">Panel @panelID</div> 
                            @if(@eventsByPanel[panelID].Count > UserSettings.PanelMaintenanceTheshold){
                                // PLACEHOLDER
                            }
                            <span class="interactions">@eventsByPanel[panelID].Count</span>
                        </div> 
                    }
                </div>
                <h6 class="listTitle">Most Active Users:</h6>
                <div class="list">
                    <div class="columnNames"><div class="title">User</div> <p>|</p> <span class="interactions">Interactions</span></div>
                    @foreach(string userID in userIDByEventCount){
                        <div class="listElement">
                            <div class="title" style="max-width: 70%;">@userID</div>
                            <span class="interactions">@eventsByUser[userID].Count</span>
                        </div>
                    }
                </div>
            </div>
        }
        <Calendar userIDByDate="@userIDByDate"/>
        <div class="settingsButton" alt="Gear icons created by Freepik - Flaticon https://www.flaticon.com/free-icons/gear">
            <NavLink class="nav-link" href="settings">
                <span><p class="settingsButton">&#9881;</p></span>
            </NavLink>
        </div>
    }
</div>




@code {
    int MAX_FILESIZE = 10000 * 1024; 
    int readerEventsCount = 0;
    List<string> readerIDByEventCount = new List<string>();
    List<int> panelIDByEventCount = new List<int>();
    List<string> userIDByEventCount = new List<string>();
    Dictionary<string, List<ReaderEvent>> eventsByReader = new Dictionary<string, List<ReaderEvent>>();
    Dictionary<string, List<ReaderEvent>> eventsByDay = new Dictionary<string, List<ReaderEvent>>();
    Dictionary<string, List<ReaderEvent>> eventsByUser = new Dictionary<string, List<ReaderEvent>>();
    Dictionary<int, List<ReaderEvent>> eventsByPanel = new Dictionary<int, List<ReaderEvent>>();
    Dictionary<string, List<string>> userIDByDate = new Dictionary<string, List<string>>();
    string ErrorMessage { get; set; } = "";
    
    protected override void OnInitialized(){
        if(@FileData.FileName != ""){
            RestoreInfo();
        }
    }
    public async Task FileUploaded(InputFileChangeEventArgs e){
        var file = e.File;
        if (file != null){
            FileData.FileName = file.Name;
            long FileSize = file.Size;
            if(file.ContentType != "text/csv"){
                ErrorMessage = "File type is not supported.";
                return;
            }
            if (file.Size > MAX_FILESIZE){
                ErrorMessage = "File size exceeds the maximum limit.";
                return;
            }
            using (var stream = new MemoryStream()){
                await file.OpenReadStream(MAX_FILESIZE).CopyToAsync(stream);
                stream.Position = 0;
                using (var reader = new StreamReader(stream)){
                    ReadFile(reader);
                }
            }
        }
    }
    public void ReadFile(StreamReader reader){
        string? line = reader.ReadLine(); 
        while ((line = reader.ReadLine()) != null)
        {
            var row = line.Split(",");
            if (row.Length >= 6)
            {
                FileData.ReaderEvents.Add(new ReaderEvent(
                    DateTime.Parse(row[0]).ToString("yyyy-MM-dd"),
                    row[1],
                    row[2].Substring(row[1].Length + 1).Substring(row[2].Substring(row[1].Length + 1).Split(' ')[0].Length + 1),
                    row[3],
                    int.Parse(row[4]),
                    int.Parse(row[5])
                ));
            }
        }

        userIDByDate = OrganizeUniqueUserIDByDay(FileData.ReaderEvents);
        
        Dictionary<string, List<ReaderEvent>> eventsByLocation = SiteData.OrganizeEvents_StringKey(FileData.ReaderEvents, "location");
        foreach(KeyValuePair<string, List<ReaderEvent>> kvp in eventsByLocation){
            MapData.Sites.Add(new Site(kvp.Key, kvp.Value));
        }
        AdditionalInfo.content.Clear();
        AdditionalInfo.content.Add("Additional information will be displayed here.");
        navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
        
    }

    Dictionary<string, List<string>> OrganizeUniqueUserIDByDay(List<ReaderEvent> totalEvents){
        Dictionary<string, List<string>> userIDByDate = new Dictionary<string, List<string>>();
        string date = "";
        List<string> tempList = new List<string>();
        foreach(ReaderEvent temp in totalEvents){
            date = temp.EventTime.Split('T')[0];
            if(!userIDByDate.ContainsKey(date)){
                tempList = new List<string>();
                userIDByDate.Add(date, tempList);
            }
            userIDByDate[date].Add(temp.UserID);
        }    
        return userIDByDate;
    }
    List<int> OrganizeKeyByCount_Int<T>(Dictionary<int, List<T>> dictionary){
        List<int> sortedList = new List<int>();
        foreach(KeyValuePair<int, List<T>> kvp in dictionary){
            for(int i = 0; i < sortedList.Count; i++){
                if(kvp.Value.Count > dictionary[sortedList[i]].Count){
                    sortedList.Insert(i, kvp.Key);
                    break;
                }
            }
            if(!sortedList.Contains(kvp.Key)){
                sortedList.Add(kvp.Key);
            }
        }
        return sortedList;
    }
    
    void HandleAlert(char type, bool subtype, int index, string listItemName){
        switch(type){
            case 'm':
                Console.WriteLine("index: " + index + " listItemName: " + listItemName);
                if(subtype){
                    Console.WriteLine("\n Maintenance Alert " + SiteData.ReaderMaintenance[listItemName] + " " + listItemName + "\n");
                    int currentValue = SiteData.ReaderMaintenance[listItemName];
                    SiteData.ReaderMaintenance[listItemName] = currentValue + 1; 
                }else{
                    Console.WriteLine("\n Maintenance Alert " + SiteData.PanelMaintenance[listItemName] + " " + listItemName + "\n");
                    int currentValue = SiteData.PanelMaintenance[listItemName];
                    SiteData.PanelMaintenance[listItemName] = currentValue + 1; 
                }
                
                FileData.SaveInfo();
                StateHasChanged();
                navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
                break;
            default:
                break;
        }
    }
    void RestoreInfo(){
        userIDByDate = OrganizeUniqueUserIDByDay(FileData.ReaderEvents);
        if(SiteData.DisplaySiteInfo){
            eventsByDay = SiteData.OrganizeEvents_StringKey(FileData.ReaderEvents, "day");
            eventsByUser = SiteData.OrganizeEvents_StringKey(FileData.ReaderEvents, "user");
            eventsByReader = SiteData.OrganizeEvents_StringKey(FileData.ReaderEvents, "reader");
            eventsByPanel = SiteData.OrganizeEvents_IntKey(FileData.ReaderEvents);        
            userIDByEventCount = SiteData.OrganizeCount_String(eventsByUser);
            readerIDByEventCount = SiteData.OrganizeCount_String(eventsByReader);
            panelIDByEventCount = OrganizeKeyByCount_Int(eventsByPanel);
        }
    }
}

