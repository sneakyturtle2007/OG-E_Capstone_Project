
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using TheAndersonProject.Services
@using TheAndersonProject.Components
@inject FileData FileData
@inject MapData MapData
@inject NavigationManager navigationManager


@if (!string.IsNullOrEmpty(ErrorMessage)){
    <div>Error: @ErrorMessage</div>
}   

<div class="main">
    @if(FileData.FileName == ""){
        <InputFile OnChange="@FileUploaded"/>
    }else{
        if(siteName == "" || siteName == "Testing"){
            <div class="listContainer">
                <h4>@siteName</h4>
                <h5 class="listTitle">Most Visited Readers:</h5>
                <div class="list">
                    @foreach(string readerID in readerIDByEventCount){
                        <div>Reader @readerID - @eventsByReader[readerID].Count Interactions</div>
                    }
                </div>
                <h5 class="listTitle">Most Active Panels:</h5>
                <div class="list">
                    @foreach(int panelID in panelIDByEventCount){
                        <div>Panel @panelID - @eventsByPanel[panelID].Count Total Pings</div>
                    }
                </div>
                <h5 class="listTitle">Most Active Users:</h5>
                <div class="list">
                    @foreach(string userID in userIDByEventCount){
                        <div>@userID - @eventsByUser[userID].Count Interactions</div>
                    }
                </div>
            </div>
        }
        <Calendar userIDByDate="@userIDByDate"/>
    }
</div>




@code {
    int MAX_FILESIZE = 10000 * 1024; 
    string FileName { get; set; } = "";
    long FileSize { get; set; } = 0;
    string FileType { get; set; } = "";
    DateTimeOffset LastModified { get; set; } = DateTimeOffset.MinValue;
    List<ReaderEvent> readerEvents = new List<ReaderEvent>();
    int readerEventsCount = 0;
    List<string> readerIDByEventCount = new List<string>();
    List<int> panelIDByEventCount = new List<int>();
    List<string> userIDByEventCount = new List<string>();
    Dictionary<string, List<ReaderEvent>> eventsByReader = new Dictionary<string, List<ReaderEvent>>();
    Dictionary<string, List<ReaderEvent>> eventsByDay = new Dictionary<string, List<ReaderEvent>>();
    Dictionary<string, List<ReaderEvent>> eventsByUser = new Dictionary<string, List<ReaderEvent>>();
    Dictionary<int, List<ReaderEvent>> eventsByPanel = new Dictionary<int, List<ReaderEvent>>();
    Dictionary<string, List<string>> userIDByDate = new Dictionary<string, List<string>>();
    string ErrorMessage { get; set; } = "";
    
    string siteName = "Testing";
    protected override void OnInitialized(){
        if(@FileData.FileName != ""){
            RestoreFileInfo();
        }
    }
    public async Task FileUploaded(InputFileChangeEventArgs e){
        var file = e.File;
        if (file != null)
        {
            FileName = file.Name;
            FileSize = file.Size;
            FileType = file.ContentType;
            LastModified = file.LastModified;
            if (file.Size > MAX_FILESIZE)
            {
                ErrorMessage = "File size exceeds the maximum limit.";
                return;
            }
            using (var stream = new MemoryStream())
            {
                await file.OpenReadStream(MAX_FILESIZE).CopyToAsync(stream);
                stream.Position = 0;
                using (var reader = new StreamReader(stream))
                {
                    ReadFile(reader);
                }
            }
        }
    }
    public void ReadFile(StreamReader reader){
        string? line = reader.ReadLine(); 
        while ((line = reader.ReadLine()) != null)
        {
            var row = line.Split(",");
            if (row.Length >= 6)
            {
                readerEvents.Add(new ReaderEvent(
                    row[0],
                    row[1],
                    row[2],
                    row[3],
                    int.Parse(row[4]),
                    int.Parse(row[5])
                ));
            }
        }

        readerEventsCount = readerEvents.Count;
        eventsByDay = OrganizeEvents_StringKey(readerEvents, "day");
        eventsByUser = OrganizeEvents_StringKey(readerEvents, "user");
        eventsByReader = OrganizeEvents_StringKey(readerEvents, "reader");
        eventsByPanel = OrganizeEventsByPanel(readerEvents);
        userIDByEventCount = OrganizeCount_String(eventsByUser);
        userIDByDate = OrganizeUniqueUserIDByDay(readerEvents);
        readerIDByEventCount = OrganizeCount_String(eventsByReader);
        panelIDByEventCount = OrganizeByCount_Int(eventsByPanel);
        Dictionary<string, List<ReaderEvent>> eventsByLocation = OrganizeEvents_StringKey(readerEvents, "location");
        SaveFileInfo(eventsByLocation);
        StateHasChanged();
        
    }
    Dictionary<string, List<ReaderEvent>> OrganizeEvents_StringKey(List<ReaderEvent> totalEvents, string category){
        Dictionary<string, List<ReaderEvent>> eventsByCategory = new Dictionary<string, List<ReaderEvent>>();
        List<ReaderEvent> tempList = new List<ReaderEvent>();
        string key = "";
        foreach(ReaderEvent temp in totalEvents){
            switch(category){
                case "user":
                    key = temp.UserID;
                    break;
                case "reader":
                    key = ""+temp.DevID + temp.Machine;
                    break;
                case "day":
                    key = DateTime.Parse(temp.EventTime).ToString("dddd");
                    break;
                case "location":
                    key = temp.Location;
                    break;
                default:
                    break;
            }
            if(!eventsByCategory.ContainsKey(key)){
                tempList = new List<ReaderEvent>();
                eventsByCategory.Add(key, tempList);
            }
            eventsByCategory[key].Add(temp);
        }
        return eventsByCategory;
    }
    Dictionary<int, List<ReaderEvent>> OrganizeEventsByPanel(List<ReaderEvent> totalEvents){
        Dictionary<int, List<ReaderEvent>> eventsByPanel = new Dictionary<int, List<ReaderEvent>>();
        List<ReaderEvent> tempList = new List<ReaderEvent>();
        foreach(ReaderEvent temp in totalEvents){
            if(!eventsByPanel.ContainsKey(temp.Machine)){
                tempList = new List<ReaderEvent>();
                eventsByPanel.Add(temp.Machine, tempList);
            }
            eventsByPanel[temp.Machine].Add(temp);
        }
        return eventsByPanel;
    }

    Dictionary<string, List<string>> OrganizeUniqueUserIDByDay(List<ReaderEvent> totalEvents){
        Dictionary<string, List<string>> userIDByDate = new Dictionary<string, List<string>>();
        string date = "";
        List<string> tempList = new List<string>();
        foreach(ReaderEvent temp in totalEvents){
            date = temp.EventTime.Split('T')[0];
            if(!userIDByDate.ContainsKey(date)){
                tempList = new List<string>();
                userIDByDate.Add(date, tempList);
            }
            userIDByDate[date].Add(temp.UserID);
        }    
        return userIDByDate;
    }
    List<int> OrganizeByCount_Int<T>(Dictionary<int, List<T>> dictionary){
        List<int> sortedList = new List<int>();
        foreach(KeyValuePair<int, List<T>> kvp in dictionary){
            for(int i = 0; i < sortedList.Count; i++){
                if(kvp.Value.Count > dictionary[sortedList[i]].Count){
                    sortedList.Insert(i, kvp.Key);
                    break;
                }
            }
            if(!sortedList.Contains(kvp.Key)){
                sortedList.Add(kvp.Key);
            }
        }
        return sortedList;
    }
    List<string> OrganizeCount_String<T>(Dictionary<string, List<T>> dictionary){
        List<string> sortedList = new List<string>();
        foreach(KeyValuePair<string, List<T>> kvp in dictionary){
            for(int i = 0; i < sortedList.Count; i++){
                if(kvp.Value.Count > dictionary[sortedList[i]].Count){
                    sortedList.Insert(i, kvp.Key);
                    break;
                }
            }
            if(!sortedList.Contains(kvp.Key)){
                sortedList.Add(kvp.Key);
            }
        }
        return sortedList;
    }
    List<int> GetPanelIDs(List<ReaderEvent> totalEvents){
        List<int> panelIDs = new List<int>();
        foreach(ReaderEvent temp in totalEvents){
            if(!panelIDs.Contains(temp.Machine)){
                panelIDs.Add(temp.Machine);
            }
        }
        return panelIDs;
    }
     void SaveFileInfo(Dictionary<string, List<ReaderEvent>> eventsByLocation){
        FileData.FileName = FileName;
        FileData.FileSize = FileSize;
        FileData.FileType = FileType;
        FileData.LastModified = LastModified;
        FileData.ReaderEventsCount = readerEventsCount;
        FileData.ReaderEvents = readerEvents;
        MapData.EventsByLocation = eventsByLocation;
        navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
    }
    void RestoreFileInfo(){
        FileName = FileData.FileName;
        FileSize = FileData.FileSize;
        FileType = FileData.FileType;
        LastModified = FileData.LastModified;
        readerEventsCount = FileData.ReaderEventsCount;
        readerEvents = FileData.ReaderEvents;
        eventsByDay = OrganizeEvents_StringKey(readerEvents, "day");
        eventsByUser = OrganizeEvents_StringKey(readerEvents, "user");
        eventsByReader = OrganizeEvents_StringKey(readerEvents, "reader");
        eventsByPanel = OrganizeEventsByPanel(readerEvents);        
        userIDByEventCount = OrganizeCount_String(eventsByUser);
        userIDByDate = OrganizeUniqueUserIDByDay(readerEvents);
        readerIDByEventCount = OrganizeCount_String(eventsByReader);
        panelIDByEventCount = OrganizeByCount_Int(eventsByPanel);
    }
}

